{
  "name": "mingzhang",
  "version": "0.1.0",
  "description": "明账 —— 本地优先的 AI 记账桌面应用（Windows · Electron + TypeScript）",
  "author": "LesterChlo (https://github.com/LesterChlo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LesterChlo/mingzhang.git"
  },
  "homepage": "https://github.com/LesterChlo/mingzhang#readme",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis zip",
    "ui-test": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "hash-wasm": "^4.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "dev.mingzhang.pi",
    "productName": "mingzhang",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "mingzhang-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "明账"
    },
    "icon": "build/icon.ico"
  },
  "productName": "mingzhang"
}
